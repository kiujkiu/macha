(version 1)
# JLC 2 层 基础工艺 (用户 2026-11-13 (五)): 1.6 mm FR4, 1 oz; 无盲埋孔 / 盘中孔
(rule "JLC_track_width"   (constraint track_width (min 0.15mm)))
(rule "JLC_clearance"     (constraint clearance (min 0.15mm)))
(rule "JLC_via_drill"     (condition "A.Type == 'Via'") (constraint hole_size (min 0.3mm)))
(rule "JLC_via_diameter"  (constraint via_diameter (min 0.6mm)))
(rule "JLC_annular"       (constraint annular_width (min 0.15mm)))
(rule "JLC_hole_to_hole"  (constraint hole_to_hole (min 0.5mm)))
(rule "JLC_edge"          (constraint edge_clearance (min 0.3mm)))
(rule "JLC_through_only"  (condition "A.Type == 'Via'") (constraint disallow buried_via micro_via))
# 无盘中孔: 过孔铜离任何焊盘 (含同网) ≥ 0.05
(rule "JLC_no_via_in_pad" (condition "A.Type == 'Via' && B.Type == 'Pad'") (constraint physical_clearance (min 0.05mm)))
